[Unit]
Description=Nagi tray and glance panel
# Started by Nagi's login entry (tray.py --login), never by a target, so a desktop
# without a systemd graphical session still gets exactly one tray.
PartOf=graphical-session.target
After=nagi-reader.service
Wants=nagi-reader.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@COMMAND@
# A crash restarts it; Quit Nagi (exit 0) and "already running" (exit 2) do not.
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
UMask=0077
